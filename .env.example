# =====================================================================
# PayVoice Environment Configuration Template (Backend Readiness)
# =====================================================================

# Server & Network
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_here
API_GATEWAY_KEY=your_internal_gateway_key_here

# Payment Aggregator Webhook Secrets (HMAC verification)
# Used to verify incoming webhook payloads from authorized banking partners
PAYMENT_WEBHOOK_SECRET=your_payment_gateway_webhook_hmac_secret
NPCI_SANDBOX_PARTNER_ID=demo_partner_id
NPCI_SANDBOX_KEY=demo_sandbox_key

# Database Connection (PostgreSQL / Redis for Soundbox Session State)
DATABASE_URL=postgresql://user:password@localhost:5432/payvoice
REDIS_URL=redis://localhost:6379

# Soundbox Hardware Push Engine (MQTT / WebSocket)
MQTT_BROKER_URL=mqtts://broker.example.com:8883
MQTT_CLIENT_USERNAME=soundbox_gateway
MQTT_CLIENT_PASSWORD=your_mqtt_password

# Telemetry & Monitoring (Optional)
LOG_LEVEL=info
SENTRY_DSN=
